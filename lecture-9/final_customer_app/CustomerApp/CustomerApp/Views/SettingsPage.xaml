<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CustomerApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CustomerApp.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="28">
            <StackPanel
                MaxWidth="720"
                HorizontalAlignment="Stretch"
                Spacing="24">

                <!-- Sidhuvud -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Inställningar"
                        Style="{StaticResource PageHeadingStyle}" />

                    <TextBlock
                        Text="Välj var ditt kundregister ska sparas."
                        Style="{StaticResource DescriptionStyle}" />
                </StackPanel>

                <!-- Lagring -->
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Kundfil"
                                Style="{StaticResource SectionHeadingStyle}" />

                            <TextBlock
                                Text="Kunderna sparas lokalt i en JSON-fil."
                                Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBox
                                Header="Fullständig sökväg"
                                PlaceholderText="C:\CustomerData\customers.json"
                                Style="{StaticResource FormTextBoxStyle}"
                                Text="{x:Bind ViewModel.CustomerFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Text="Ange både mapp och filnamn, exempelvis C:\CustomerData\customers.json."
                                Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>

                        <Border Style="{StaticResource InformationCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="När du byter filplats"
                                    Style="{StaticResource SectionHeadingStyle}" />

                                <TextBlock
                                    Text="Kundlistan hämtas från den nya filen. Dina tidigare kunder ligger kvar i den gamla filen."
                                    Style="{StaticResource DescriptionStyle}" />

                                <TextBlock
                                    Text="Om den nya filen inte finns skapas den när du sparar din första kund."
                                    Style="{StaticResource DescriptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ProgressRing
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Style="{StaticResource DescriptionStyle}" />
                </Grid>

                <Button
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{x:Bind ViewModel.SaveCommand}">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="Spara inställningar" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>