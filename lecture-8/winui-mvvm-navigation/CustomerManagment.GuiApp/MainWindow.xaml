<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CustomerManagment.GuiApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CustomerManagment.GuiApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Customer Managment">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="MainNavigation"
                    IsBackButtonVisible="Visible"
                    IsBackEnabled="False"
                    ItemInvoked="MainNavigation_ItemInvoked"
                    BackRequested="MainNavigation_BackRequested"
                    >

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeNavigationItem" Content="Home" Tag="home" Icon="Home" />
        </NavigationView.MenuItems>
        
        
        <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />

    </NavigationView>
</Window>
